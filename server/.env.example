# The Postgres database. On Railway, reference the Postgres service's DATABASE_URL.
# Tables go in the "dune" schema, so the database can be shared with another project.
DATABASE_URL=postgresql://user:password@host:port/database

# Signs the login tokens. Use a long random value, different from any other project's.
JWT_SECRET=

# Sites allowed to call the server, comma separated
ALLOWED_ORIGINS=https://ericprieur.github.io,http://localhost:5173

# Railway sets PORT itself; 3001 is used on this computer otherwise
# PORT=3001
